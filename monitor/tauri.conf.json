{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giám sát Công Cụ File",
  "version": "0.1.0",
  "identifier": "vn.congcufile.monitor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Giám sát Công Cụ File",
        "width": 1320,
        "height": 800,
        "maximized": true,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
