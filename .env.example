# Chép file này thành ".env" (cùng thư mục) rồi sửa giá trị. File .env không đưa lên Git.

# Các mã bí mật. Đặt chuỗi dài, khó đoán, mỗi mã một chuỗi khác nhau (bắt buộc đổi trước khi mở ra internet).
# Mã giữa API và worker (máy xử lý).
WORKER_KEY=dev-worker-key
# Mã cho app giám sát (cửa quản trị).
ADMIN_KEY=dev-admin-key
# Khoá ký link tải lên/tải về có thời hạn của API v1.
STORAGE_SIGNING_KEY=dev-storage-signing-key-chi-dung-khi-chay-thu

# Máy có GPU NVIDIA: bỏ dấu # dòng dưới để "docker compose up -d" bật luôn phần AI.
# COMPOSE_PROFILES=ai

# Mô hình cho Tóm tắt/Dịch. qwen2.5:7b hợp GPU 16 GB; máy yếu dùng qwen2.5:1.5b.
OLLAMA_MODEL=qwen2.5:7b
